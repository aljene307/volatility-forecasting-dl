# Par défaut : Git détecte le texte et le stocke en LF
* text=auto eol=lf

# Fichiers texte forcés en LF
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.ipynb text eol=lf

# Scripts Windows : CRLF
*.ps1   text eol=crlf

# Binaires : aucune conversion, aucun diff texte
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.onnx    binary
*.pt      binary
*.pth     binary
*.ckpt    binary
*.parquet binary
*.pkl     binary
*.joblib  binary
*.npz     binary
*.npy     binary
*.zip     binary
*.xlsx    binary
